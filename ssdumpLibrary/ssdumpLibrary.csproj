<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ssdump</RootNamespace>
    <AssemblyName>ssdumplib</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Replaces the SQL Server 2014 SDK DLLs (ConnectionInfo, Management.Sdk.Sfc, Smo v12). -->
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.37.1" />
    <!-- SMO pulls in Pkcs 9.0.4, which has known vulnerabilities; pin a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
</Project>
